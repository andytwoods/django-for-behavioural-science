# Copy to .env for local overrides, or set these as environment variables in production.
# Local development works with NO .env file at all (sensible defaults are built in).
# .env is gitignored; never commit real secrets.

# Off in production. Leave unset (or True) for local development.
DJANGO_DEBUG=False

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value

# Comma-separated hostnames your site answers on.
DJANGO_ALLOWED_HOSTS=your-app.example.com

# Your site's origin(s), with scheme, for cross-site POST protection.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# Production database. django-environ parses this URL into Django's DATABASES setting.
# Local development defaults to SQLite when this is unset.
DATABASE_URL=postgres://user:password@host:5432/dbname
